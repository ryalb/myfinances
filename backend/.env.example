DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Hosts de tunel publico (ngrok/cloudflared), separados por virgula.
# Requisicoes que chegarem por eles so alcancam /api/v1/pluggy/webhook/ e
# /health/; todo o resto recebe 404. OBRIGATORIO se voce expoe a porta 8000:
# o tunel encaminha a porta inteira, entao sem isto /admin/, /graphql/ e
# /api/v1/auth/token/ ficam publicos -- com traceback completo se DEBUG=True.
DJANGO_PUBLIC_TUNNEL_HOSTS=""

# Registro publico de usuarios. Para uso pessoal, mantenha desligado:
# ligado, qualquer pessoa com acesso a API cria uma conta.
DJANGO_ALLOW_PUBLIC_REGISTRATION=False

# Categorias da Pluggy (provider_category) tratadas como movimentacao interna
# (pagamento de fatura de cartao, transferencia entre contas proprias) e por
# isso excluidas do calculo de receita/despesa mensal -- nao sao dinheiro novo
# entrando nem saindo, so mudando de conta. Separadas por virgula, sem distincao
# de maiusculas/minusculas. Comentada (nao setada): usa o default do
# settings.py. So descomente se precisar acrescentar/trocar as categorias.
# FINANCE_INTERNAL_TRANSFER_CATEGORIES=""

POSTGRES_DB=myfinances
POSTGRES_USER=myfinances
POSTGRES_PASSWORD=myfinances
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Pluggy API base URL
# Production: https://api.pluggy.ai
# Sandbox:    https://api.sandbox.pluggy.ai  (o Meu Pluggy NAO funciona em sandbox)
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# URL publica que a Pluggy chama quando um item termina de sincronizar.
# Sem isso nao existe sincronizacao automatica: o item e criado sem webhook.
# Em dev, exponha a porta 8000 com ngrok/cloudflared.
# Precisa incluir o ?token=<PLUGGY_WEBHOOK_SECRET> para passar a validacao.
PLUGGY_WEBHOOK_URL=""

# Segredo compartilhado que autentica as chamadas no endpoint de webhook.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLUGGY_WEBHOOK_SECRET=""

OLLAMA_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="qwen2.5:14b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"