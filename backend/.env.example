DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=myfinances
POSTGRES_USER=myfinances
POSTGRES_PASSWORD=myfinances
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Pluggy API base URL
# Production: https://api.pluggy.ai
# Sandbox:    https://api.sandbox.pluggy.ai  (o Meu Pluggy NAO funciona em sandbox)
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# URL publica que a Pluggy chama quando um item termina de sincronizar.
# Sem isso nao existe sincronizacao automatica: o item e criado sem webhook.
# Em dev, exponha a porta 8000 com ngrok/cloudflared.
# Precisa incluir o ?token=<PLUGGY_WEBHOOK_SECRET> para passar a validacao.
PLUGGY_WEBHOOK_URL=""

# Segredo compartilhado que autentica as chamadas no endpoint de webhook.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLUGGY_WEBHOOK_SECRET=""

OLLAMA_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="qwen2.5:14b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"